# Gemini credentials are read only by the local Vite middleware or the serverless API route.
# Do not prefix this key with VITE_ or expose it to browser code.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional: URL for a separately deployed server-side FinBuddy endpoint.
VITE_FINBUDDY_ENDPOINT=/api/finbuddy
